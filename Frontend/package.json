{
	"name": "neuroscan-frontend",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write src",
		"format:check": "prettier --check src",
		"lint:dupes": "jscpd --config .jscpd.json",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm run lint:dupes && npm run test && npm run build"
	},
	"dependencies": {
		"@kitware/vtk.js": "^37.3.0",
		"@radix-ui/react-dialog": "^1.1.14",
		"@radix-ui/react-dropdown-menu": "^2.1.15",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-slider": "^1.3.5",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-switch": "^1.2.5",
		"@radix-ui/react-tabs": "^1.1.12",
		"@radix-ui/react-tooltip": "^1.2.7",
		"@tanstack/react-query": "^5.83.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.462.0",
		"nifti-reader-js": "^0.8.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-router-dom": "^7.18.4",
		"recharts": "^2.15.4",
		"sonner": "^1.7.4",
		"tailwind-merge": "^2.6.0",
		"tailwindcss-animate": "^1.0.7"
	},
	"devDependencies": {
		"@eslint/js": "^9.32.0",
		"@testing-library/jest-dom": "^6.6.0",
		"@testing-library/react": "^16.0.0",
		"@types/node": "^22.16.5",
		"@types/react": "^18.3.23",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"autoprefixer": "^10.4.21",
		"eslint": "^9.32.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.20",
		"globals": "^15.15.0",
		"jscpd": "^5.3.2",
		"jsdom": "^30.1.1",
		"postcss": "^8.5.28",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.6.0",
		"typescript-eslint": "^8.24.0",
		"vite": "^8.3.1",
		"vite-plugin-glsl": "^1.6.1",
		"vitest": "^5.0.2"
	},
	"engines": {
		"node": ">=22"
	}
}
