{
	"name": "neuroscan-frontend",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write src",
		"format:check": "prettier --check src",
		"lint:dupes": "jscpd --config .jscpd.json",
