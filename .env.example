# Copy to .env (git-ignored) and fill in. `npm run dev` creates a development .env automatically.
# The backend refuses to start if a required value is missing or insecure.

# "production" (default): API docs off, HSTS on. Use "development" only on your own machine.
ENVIRONMENT=production

# Required. Random, at least 32 characters. Rotating it signs every user out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Required. Encrypts two-factor secrets at rest. Rotating it disables every user's 2FA enrolment.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# Optional. Defaults to sqlite:///<Backend folder>/neuroscan.db
# DATABASE_URL=sqlite:///D:/data/neuroscan.db

# Optional. Defaults to <Backend folder>/uploads. Keep it outside any web-served folder.
# UPLOAD_DIR=D:/data/neuroscan-uploads

# Optional model weight paths (defaults shown; relative paths resolve against Backend/).
# DETECTION_WEIGHTS=../Materials/Notebooks/binary-detection/weights/deploy/EfficientNetB0.pth
# CLASSIFICATION_WEIGHTS=../Materials/Notebooks/classification/weights/deploy/EfficientNetB0.pth
# SEGMENTATION_WEIGHTS=../Materials/Notebooks/segmentation/weights/deploy/VNet.pth

# Only needed when the frontend is served from a different origin than /api (comma separated).
# Leave empty when the Vite dev server or a reverse proxy serves both from one origin.
CORS_ORIGINS=

# Session cookie lifetime and flags.
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=true

# Set to false once all staff accounts exist.
ALLOW_REGISTRATION=true

# Upload and processing limits.
MAX_UPLOAD_FILE_MB=300
MAX_PENDING_JOBS=8
AUTH_RATE_LIMIT_PER_MINUTE=10

LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
